#!/usr/bin/env bash
#-------------------------------------------------------------------------------
# Test stub: curl
#
# - Provider key-verification endpoints (groq/openrouter/google/cerebras/
#   mistral) answer with KEYCHECK_CODE (default: 200).
# - Anything else using -w '%{http_code}' (the health check) answers with
#   HEALTH_CODE (default: 200).
#-------------------------------------------------------------------------------
for a in "$@"; do
  case "$a" in
    *api.groq.com*|*openrouter.ai*|*generativelanguage.googleapis.com*|*api.cerebras.ai*|*api.mistral.ai*)
      printf '%s' "${KEYCHECK_CODE:-200}"
      exit 0
      ;;
  esac
done
code="${HEALTH_CODE:-200}"
for a in "$@"; do
  case "$a" in
    *%{http_code}*)
      printf '%s' "$code"
      exit 0
      ;;
  esac
done
exit 0
